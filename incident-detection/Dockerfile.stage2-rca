# Causa Stage-2 RCA image.
# Build context is the repository root because auto-remediation shares the
# dashboard's Postgres plan store:
#   docker build -f incident-detection/Dockerfile.stage2-rca -t causa/stage2-rca:latest .
FROM python:3.12-slim

WORKDIR /app/incident-detection

# Planning reads the current workload revision before producing an exact,
# fingerprinted plan. Mutation remains confined to the remediation worker.
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
  && curl -fsSL -o /usr/local/bin/kubectl https://dl.k8s.io/release/v1.31.0/bin/linux/amd64/kubectl \
  && chmod +x /usr/local/bin/kubectl \
  && rm -rf /var/lib/apt/lists/*

# Copy the package inputs explicitly so deployment-only files and tests never
# enter the runtime image. The trigger extra provides psycopg.
COPY incident-detection/pyproject.toml ./
COPY incident-detection/contracts/ ./contracts/
COPY incident-detection/ingest/ ./ingest/
COPY incident-detection/anomaly/ ./anomaly/
COPY incident-detection/graphs/ ./graphs/
COPY incident-detection/isolation/ ./isolation/
COPY incident-detection/rca/ ./rca/
COPY incident-detection/scoring/ ./scoring/
COPY incident-detection/adapters/ ./adapters/
COPY incident-detection/classify/ ./classify/
COPY incident-detection/eval/ ./eval/
COPY incident-detection/remediation/ ./remediation/
COPY incident-detection/runtime/ ./runtime/
COPY incident-detection/profiles/ ./profiles/
COPY incident-detection/fixtures/ ./fixtures/
COPY incident-detection/testbed/ ./testbed/
COPY dashboard/backend/ /app/dashboard/backend/
COPY dashboard/__init__.py /app/dashboard/__init__.py

RUN pip install --no-cache-dir ".[trigger]"

RUN useradd --uid 10001 --create-home causa
USER causa
ENV PYTHONPATH=/app:/app/incident-detection

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=2)"]

CMD ["python", "-m", "rca.trigger.app"]
