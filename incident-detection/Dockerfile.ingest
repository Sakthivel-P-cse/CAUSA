# Causa Dev-A ingestion image — runs the RCA-trigger service.
# Build context is incident-detection/ (this repo).
#   docker build -f Dockerfile.ingest -t causa/ingest:latest .
FROM python:3.12-slim

WORKDIR /app

# Install runtime deps first (layer cache). The trigger extra pulls psycopg.
COPY pyproject.toml ./
COPY contracts/ ./contracts/
COPY ingest/ ./ingest/
COPY anomaly/ ./anomaly/
# These packages are declared in pyproject.toml's explicit package list. They
# must be present while setuptools builds the shared distribution even though
# the ingest service does not import or execute the RCA path.
COPY graphs/ ./graphs/
COPY isolation/ ./isolation/
COPY rca/ ./rca/
COPY scoring/ ./scoring/
COPY adapters/ ./adapters/
COPY classify/ ./classify/
COPY eval/ ./eval/
COPY remediation/ ./remediation/
COPY runtime/ ./runtime/
COPY profiles/ ./profiles/
COPY fixtures/ ./fixtures/
COPY testbed/ ./testbed/

RUN pip install --no-cache-dir ".[trigger]"

# Non-root
RUN useradd --uid 10001 --create-home causa
USER causa

EXPOSE 8080

# /health for probes, /trigger for the Alertmanager webhook.
CMD ["python", "-m", "ingest.trigger.app"]
