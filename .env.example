# Causa — environment reference.
#
# Copy to .env and fill in. Never commit real keys.
# Sourced by causa-startup.sh (`set -a; source .env`), so this must stay valid
# shell: no spaces around `=`, quote anything containing spaces or globs.
#
# Values shown are the DEFAULTS BAKED INTO THE CODE. A commented line documents
# the default; uncomment only to override it. Vars with no default are marked
# REQUIRED where the component genuinely cannot start without them.
#
# ============================================================================
# 1. Secrets — no safe default, never commit
# ============================================================================

# NVIDIA NIM (LLM-assisted remediation narrative). CAUSA_NIM_ENABLED=0 to disable.
NVIDIA_API_KEY=
CAUSA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
CAUSA_NIM_MODEL=z-ai/glm-5.2
CAUSA_NIM_ENABLED=1
#CAUSA_NIM_TIMEOUT_S=180
#CAUSA_NIM_MANUAL_PROMPT_MAX=4096

# GitHub (code-fix PR branch of the remediation router).
GITHUB_TOKEN=
#GH_TOKEN=                      # alternative name; GITHUB_TOKEN preferred
CAUSA_GITHUB_PR_ENABLED=1
CAUSA_GITHUB_AUTOCOMMIT=0
CAUSA_GITHUB_REPO=
CAUSA_REMEDIATION_REPO=
CAUSA_REMEDIATION_BASE=main

# ============================================================================
# 2. Trigger / webhook auth
# ============================================================================
# Both trigger services FAIL CLOSED: with no TRIGGER_AUTH_TOKEN set they answer
# 503 rather than accepting anonymous alerts. Setting
# CAUSA_TRIGGER_ALLOW_UNAUTHENTICATED=1 is the ONLY way to run them open, and it
# is for local debugging only.
#
# In-cluster, this token must be IDENTICAL in three places or alerts 401:
#   - alertmanager-webhook-auth   (what Alertmanager presents)
#   - causa-ingest-secret         (what causa-ingest validates)
#   - stage2-rca-secret           (what Stage-2 validates)
TRIGGER_AUTH_TOKEN=replace-with-random-trigger-token
STAGE2_AUTH_TOKEN=replace-with-random-stage2-token
CAUSA_TRIGGER_ALLOW_UNAUTHENTICATED=0

# Dashboard API auth.
CAUSA_API_REQUIRE_AUTH=1
CAUSA_API_VIEWER_TOKEN=replace-with-random-viewer-token
CAUSA_REMEDIATION_PROPOSER_TOKEN=replace-with-random-proposer-token
REMEDIATION_APPROVAL_TOKEN=replace-with-random-approver-token
CAUSA_REMEDIATION_REQUIRE_TOKEN=1
# Comma-separated allowed browser origins. Empty = no cross-origin access
# (credentials are only allowed when this is non-empty).
#CAUSA_CORS_ORIGINS=

# ============================================================================
# 3. Telemetry backends
# ============================================================================
# Local defaults assume causa-startup.sh port-forwards. In-cluster the code
# defaults are the .svc.cluster.local names shown in the comments.
PROMETHEUS_URL=http://127.0.0.1:9090
LOKI_URL=http://127.0.0.1:3100          # in-cluster: http://loki.loki.svc.cluster.local:3100
TEMPO_URL=http://127.0.0.1:3200         # in-cluster: http://tempo.tempo.svc.cluster.local:3200
#OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317

# ============================================================================
# 4. Postgres
# ============================================================================
# Three roles with distinct grants: rca_engine (writes reports),
# causa_remediator (owns remediation_plans/events), causa_eval (read-only).
PGHOST=127.0.0.1                # in-cluster: postgres.postgres.svc.cluster.local
PGPORT=15432                    # in-cluster: 5432
PGDATABASE=causa
PGUSER=rca_engine
PGPASSWORD=
# Full DSNs override the discrete PG* vars when set.
#CAUSA_PG_DSN=
#CAUSA_EVAL_DSN=
#CAUSA_REMEDIATION_PG_DSN=
# Remediation worker connection; each falls back to its PG* equivalent.
#REMEDIATION_PGHOST=
#REMEDIATION_PGPORT=
#REMEDIATION_PGDATABASE=
REMEDIATION_PGUSER=causa_remediator
REMEDIATION_PGPASSWORD=

# ============================================================================
# 5. Scope — which services Causa considers
# ============================================================================
CAUSA_APP_NAMESPACE=otel-demo
CAUSA_PROFILE=otel-demo         # see incident-detection/profiles/*.json
# Empty regex = no filter. Set these when porting to a cluster that is not the
# OTel Demo, or the graph fills with infrastructure noise.
#CAUSA_MONITORED_SERVICES_REGEX=
#CAUSA_EXCLUDED_SERVICES_REGEX=
#CAUSA_SERVICE_NAME_LABEL_KEYS=job,service,service_name,app,app_kubernetes_io_name
#CAUSA_LOOKBACK_MIN=10          # incident window lookback

# ============================================================================
# 6. Remediation safety
# ============================================================================
# Defaults are deliberately fail-safe: nothing applies without explicit opt-in.
CAUSA_REMEDIATION_KILL_SWITCH=0         # 1 = block every action, globally
CAUSA_REMEDIATION_AUTO_PROPOSE=0
CAUSA_REMEDIATION_AUTO_APPLY=0
CAUSA_REMEDIATION_AUTO_ACTIONS=
#CAUSA_REMEDIATION_ALLOW_INFRA=0        # 1 = permit scale_restart_cordon
REMEDIATION_NAMESPACE=otel-demo
REMEDIATION_ALLOWED_NAMESPACES=otel-demo
#CAUSA_REMEDIATION_KILL_NS=             # per-namespace kill switch
#CAUSA_REMEDIATION_KILL_SERVICE=        # per-service kill switch
#REMEDIATION_CONFIGMAP_NAME=            # config-patch target (Gatekeeper-allowlisted)
#REMEDIATION_CONFIGMAP_KEY=
#REMEDIATION_MAX_REPLICAS=5
# Minimum confidence to auto-act. NOTE: confidence_score is a rank MARGIN, not a
# calibrated probability — treat any threshold here as a heuristic until the
# calibration map exists.
#REMEDIATION_MIN_CONFIDENCE=
#CAUSA_AUTO_REMEDIATION_MIN_CALIBRATION_N=30
#CAUSA_AUTO_REMEDIATION_MIN_HOLDOUT_N=10

# ============================================================================
# 7. Service tuning (rarely changed)
# ============================================================================
#TRIGGER_PORT=8080
#TRIGGER_WORKERS=2
#TRIGGER_MAX_BODY_BYTES=1048576
#STAGE2_WEBHOOK_URL=http://stage2-rca.stage2-rca.svc.cluster.local:8080/trigger
#STAGE2_FORWARD_RETRIES=3
#STAGE2_FORWARD_TIMEOUT=5.0
#STAGE2_OUTBOX_INTERVAL=30
#REMEDIATION_WORKER_POLL_S=5
#REMEDIATION_WORKER_ID=                 # defaults to hostname
#REMEDIATION_HEARTBEAT_S=60
#REMEDIATION_OBSERVE_SLEEP_S=15
#DASHBOARD_PORT=8090
#LOG_LEVEL=INFO
#CAUSA_ENVIRONMENT=
# Fitted T/D/P weights + calibration map. Absent = equal thirds, raw confidence.
#RCA_WEIGHTS_ARTIFACT=incident-detection/eval/artifacts/fit_result.json

# ============================================================================
# 8. Local dev only
# ============================================================================
#CONTEXT=kind-gcp-demo-test
#KUBECTL_CONTEXT=
#CAUSA_DASHBOARD_OUTPUTS=               # file fallback when Postgres is absent
#CAUSA_REMEDIATION_STORE=
#CAUSA_REMEDIATION_ALLOW_FILE_STORE=0
# Set to a throwaway DB (schema via ./scripts/render-schema.sh) to un-skip the
# infra-handoff blocker tests; CI sets both.
#CAUSA_TEST_PG_DSN=
#CAUSA_TEST_NODE=
